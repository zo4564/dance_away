<style>
    .calendar {
        display: grid;
        grid-template-columns: repeat(7, minmax(150px, 1fr));
        min-width: 1050px;
    }

    .day {
        min-height: 500px;
        border-right: 1px solid var(--bs-border-color);
    }

    .day:last-child {
        border-right: 0;
    }

    .day-header {
        background: var(--bs-light);
        border-bottom: 1px solid var(--bs-border-color);
    }

    .lesson {
        border-left: 4px solid var(--lesson-color);
        background-color: color-mix(
                in srgb,
                var(--lesson-color) 10%,
                white
        );
    }

    .lesson:hover {
        background-color: color-mix(
                in srgb,
                var(--lesson-color) 18%,
                white
        );
    }
</style>

<div class="container-fluid py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between
              align-items-md-center gap-3 mb-4">

    <div>
      <h1 class="h2 mb-1">
        <%= t(".title") %>
      </h1>

      <div class="text-body-secondary">
        <%= l(@week_start, format: :long) %>
        –
        <%= l(@week_start.end_of_week, format: :long) %>
      </div>
    </div>

    <div class="btn-group">
      <%= link_to "←",
                  callendar_path(week: @week_start - 1.week),
                  class: "btn btn-outline-secondary" %>

      <%= link_to t(".today"),
                  callendar_path,
                  class: "btn btn-outline-secondary" %>

      <%= link_to "→",
                  callendar_path(week: @week_start + 1.week),
                  class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @lessons.any? %>
    <div class="card shadow-sm overflow-hidden">
      <div class="card-body p-0 overflow-auto">
        <div class="calendar">

          <% 7.times do |day_offset| %>
            <% day = @week_start + day_offset.days %>
            <% lessons = @lessons_by_day[day] || [] %>

            <div class="day">

              <div class="day-header text-center p-3">
                <div class="small text-body-secondary">
                  <%= l(day, format: "%A") %>
                </div>

                <div class="fs-4 fw-semibold">
                  <%= day.day %>
                </div>
              </div>

              <div class="p-2">

                <% lessons.each do |lesson| %>
                  <% dance_style = lesson.dance_class.dance_style %>

                  <%= link_to lesson_path(lesson),
                              class: "lesson d-block
                                      rounded p-3 mb-2
                                      text-decoration-none text-body",
                              style: "--lesson-color: #{dance_style.color};" do %>

                    <div class="small text-body-secondary">
                      <%= lesson.starts_at.strftime("%H:%M") %>
                      –
                      <%= lesson.ends_at.strftime("%H:%M") %>
                    </div>

                    <div class="fw-semibold mt-1">
                      <%= lesson.dance_class.name %>
                    </div>

                    <span
                      class="badge mt-2"
                      style="
                      background-color: <%= dance_style.color %>;
                        color: #fff;
                      "
                    >
                      <%= dance_style.name %>
                    </span>

                    <% if current_user.student? && lesson.teacher.present? %>
                      <div class="small text-body-secondary mt-2">
                        <%= lesson.teacher.first_name %>
                        <%= lesson.teacher.last_name %>
                      </div>
                    <% end %>

                  <% end %>
                <% end %>

              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t(".empty") %>
    </div>
  <% end %>
</div>