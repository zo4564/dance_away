<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 mb-1"><%= t(".title") %></h1>
    </div>
  </div>

  <% if @lessons.any? %>
    <div class="row g-4">
      <% @lessons.each do |lesson| %>
        <% dance_style = lesson.dance_class.dance_style %>

        <div class="col-md-6 col-lg-4">
          <div
            class="card h-100 shadow-sm"
            style="border-left: 5px solid <%= dance_style.color %>;"
          >
            <div class="card-body d-flex flex-column">
              <div class="mb-3">
                <span
                  class="badge"
                  style="
                  background-color: <%= dance_style.color %>;
                    color: #fff;
                  "
                >
                  <%= dance_style.name %>
                </span>
              </div>

              <h2 class="h5">
                <%= link_to lesson.dance_class.name,
                            lesson_path(lesson),
                            class: "text-decoration-none" %>
              </h2>

              <dl class="mb-4">
                <dt class="small text-body-secondary">
                  <%= t(".teacher") %>
                </dt>

                <dd>
                  <%= lesson.teacher.first_name %>
                  <%= lesson.teacher.last_name %>
                </dd>

                <dt class="small text-body-secondary">
                  <%= t(".date") %>
                </dt>

                <dd>
                  <%= l(lesson.starts_at, format: :long) %>
                  -
                  <%= l(lesson.ends_at, format: :hour) %>
                </dd>

                <dt class="small text-body-secondary">
                  <%= t(".places") %>
                </dt>

                <dd class="mb-0">
                  <%= lesson.available_places %>
                  <%= t(".available_places") %>
                  / <%= lesson.capacity %>
                </dd>
              </dl>

              <div class="mt-auto">
                <%= link_to t(".details"),
                            lesson_path(lesson),
                            class: "btn btn-outline-primary w-100" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t(".empty") %>
    </div>
  <% end %>
</div>