<div class="container py-4">
  <div class="mb-4">
    <h1><%= t(".title") %></h1>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= render "shared/view_switcher", view: @view %>

    <% if current_user&.teacher? %>
      <%= link_to t(".unassigned"),
                  lessons_path(
                    view: @view,
                    unassigned: "true"
                  ),
                  class: "btn btn-outline-primary" %>
    <% end %>
  </div>

  <% if @view == "calendar" %>
    <%= render "shared/lessons_calendar",
               week_days: @week_days,
               lessons_by_day: @lessons_by_day %>
  <% else %>
    <%= render "shared/lessons_list",
               lessons: @lessons %>
  <% end %>
</div>