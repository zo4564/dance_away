<% dance_style = @lesson.dance_class.dance_style %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div
        class="card shadow-sm"
        style="border-top: 5px solid <%= dance_style.color %>;"
      >
        <div class="card-body">
          <div class="mb-3">
            <span
              class="badge"
              style="
              background-color: <%= dance_style.color %>;
                color: #fff;
              "
            >
              <%= dance_style.name %>
            </span>
          </div>

          <h1 class="card-title mb-4">
            <%= @lesson.dance_class.name %>
          </h1>

          <dl class="row">
            <dt class="col-sm-4">
              <%= t("lessons.show.style") %>
            </dt>

            <dd class="col-sm-8">
              <span
                class="badge"
                style="
                background-color: <%= dance_style.color %>;
                  color: #fff;
                "
              >
                <%= dance_style.name %>
              </span>
            </dd>

            <dt class="col-sm-4">
              <%= t("lessons.show.description") %>
            </dt>

            <dd class="col-sm-8">
              <%= @lesson.dance_class.description %>
            </dd>

            <dt class="col-sm-4">
              <%= t("lessons.show.teacher") %>
            </dt>

            <dd class="col-sm-8">
              <% if @lesson.teacher.present? %>
                <%= @lesson.teacher.first_name %>
                <%= @lesson.teacher.last_name %>
              <% else %>
                <span class="text-muted">
                  <%= t("lessons.show.no_teacher") %>
                </span>
              <% end %>
            </dd>

            <dt class="col-sm-4">
              <%= t("lessons.show.date") %>
            </dt>

            <dd class="col-sm-8">
              <%= l(@lesson.starts_at, format: :long) %>
              -
              <%= @lesson.ends_at.strftime("%H:%M") %>
            </dd>

            <dt class="col-sm-4">
              <%= t("lessons.show.places") %>
            </dt>

            <dd class="col-sm-8">
              <%= t(
                    "lessons.show.booked",
                    booked: @lesson.booked_places,
                    capacity: @lesson.capacity
                  ) %>
            </dd>

            <dt class="col-sm-4">
              <%= t("lessons.show.available_places") %>
            </dt>

            <dd class="col-sm-8">
              <%= @lesson.available_places %>
            </dd>
          </dl>

          <hr>

          <% if user_signed_in? %>
            <% if current_user.teacher? && @lesson.teacher.nil? %>
              <% if @lesson.teacher_applied?(current_user) %>
                <div class="alert alert-info">
                  <%= t("lessons.show.teacher_application_pending") %>
                </div>
              <% end %>
            <% end %>

            <div class="d-flex gap-2 flex-wrap">
              <% if current_user.teacher? &&
                    @lesson.teacher.nil? &&
                    !@lesson.teacher_applied?(current_user) %>
                <%= button_to t("lessons.show.apply_as_teacher"),
                              lesson_teacher_applications_path(@lesson),
                              method: :post,
                              class: "btn btn-outline-primary" %>
              <% end %>

              <% if @lesson.booked_by?(current_user) %>
                <%= button_to t("lessons.show.cancel_booking"),
                              lesson_booking_path(@lesson),
                              method: :delete,
                              class: "btn btn-outline-danger",
                              data: {
                                turbo_confirm: t(
                                  "lessons.show.cancel_booking_confirmation"
                                )
                              } %>

              <% elsif @lesson.available_places > 0 %>
                <%= button_to t("lessons.show.book"),
                              lesson_bookings_path(@lesson),
                              method: :post,
                              class: "btn btn-primary" %>

              <% else %>
                <div class="alert alert-warning mb-0">
                  <%= t("lessons.show.no_places") %>
                </div>
              <% end %>
            </div>

          <% else %>
            <%= link_to t("lessons.show.sign_in_to_book"),
                        new_user_session_path,
                        class: "btn btn-primary" %>
          <% end %>

          <div class="mt-4">
            <%= link_to t("lessons.show.back"),
                        lessons_path,
                        class: "btn btn-link px-0" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>