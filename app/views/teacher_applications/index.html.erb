<div class="container py-4">
  <div class="mb-4">
    <h1><%= t("teacher_applications.index.title") %></h1>
    <p class="text-muted">
      <%= t("teacher_applications.index.description") %>
    </p>
  </div>

  <% if @applications.any? %>
    <div class="row g-4">
      <% @applications.each do |application| %>
        <div class="col-12 col-lg-3">
          <div class="card shadow-sm h-100">
            <div class="card-body">

              <h2 class="h5">
                <%= application.lesson.dance_class.name %>
              </h2>

              <p class="text-muted mb-3">
                <%= application.lesson.dance_class.dance_style.name %>
              </p>

              <p>
                <strong><%= t("teacher_applications.index.date") %>:</strong><br>
                <%= l(application.lesson.starts_at, format: :long) %>
                —
                <%= application.lesson.starts_at.strftime("%H:%M") %>
              </p>

              <p>
                <strong><%= t("teacher_applications.index.status") %>:</strong><br>

                <% case application.status %>
                <% when "pending" %>
                  <span class="badge text-bg-warning">
                    <%= t("teacher_applications.index.statuses.pending") %>
                  </span>

                <% when "accepted" %>
                  <span class="badge text-bg-success">
                    <%= t("teacher_applications.index.statuses.accepted") %>
                  </span>

                <% when "rejected" %>
                  <span class="badge text-bg-danger">
                    <%= t("teacher_applications.index.statuses.rejected") %>
                  </span>
                <% end %>
              </p>

              <%= link_to t("teacher_applications.index.show_lesson"),
                          lesson_path(application.lesson),
                          class: "btn btn-sm btn-outline-primary" %>

            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t("teacher_applications.index.empty") %>
    </div>
  <% end %>
</div>