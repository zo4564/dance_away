<div class="container py-4">
  <div class="mb-4">
    <h1><%= t(".title") %></h1>
    <p class="text-muted"><%= t(".subtitle") %></p>
  </div>

  <%= render "shared/view_switcher", view: @view %>

  <% if @view == "calendar" %>
    <%= render "shared/lessons_calendar",
               week_days: @week_days,
               lessons_by_day: @lessons_by_day %>
  <% else %>
    <%= render "shared/lessons_list",
               lessons: @lessons %>
  <% end %>
</div>