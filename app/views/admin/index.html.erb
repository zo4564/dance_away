<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Zarządzanie zajęciami</h1>
      <p class="text-muted mb-0">
        Tworzenie, edycja i zarządzanie zajęciami.
      </p>
    </div>

    <%= link_to "Dodaj zajęcia",
                new_admin_lesson_path,
                class: "btn btn-primary" %>
  </div>

  <% if @lessons.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
        <tr>
          <th>Data</th>
          <th>Zajęcia</th>
          <th>Prowadzący</th>
          <th>Uczestnicy</th>
          <th></th>
        </tr>
        </thead>

        <tbody>
        <% @lessons.each do |lesson| %>
          <tr>
            <td>
              <%= l(lesson.starts_at, format: :long) %>
              <br>
              <span class="text-muted">
                <%= lesson.starts_at.strftime("%H:%M") %>
                -
                <%= lesson.ends_at.strftime("%H:%M") %>
              </span>
            </td>

            <td>
              <strong>
                <%= lesson.dance_class.name %>
              </strong>

              <div class="small text-muted">
                <%= lesson.dance_class.dance_style.name %>
              </div>
            </td>

            <td>
              <% if lesson.teacher.present? %>
                <%= lesson.teacher.first_name %>
                <%= lesson.teacher.last_name %>
              <% else %>
                  <span class="text-muted">
                    Brak prowadzącego
                  </span>
              <% end %>
            </td>

            <td>
              <%= lesson.booked_places %>
              /
              <%= lesson.capacity %>
            </td>

            <td class="text-end">
              <%= link_to "Uczestnicy",
                          participants_admin_lesson_path(lesson),
                          class: "btn btn-sm btn-outline-primary" %>

              <%= link_to "Edytuj",
                          edit_admin_lesson_path(lesson),
                          class: "btn btn-sm btn-outline-secondary" %>

              <%= button_to "Usuń",
                            admin_lesson_path(lesson),
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger",
                            data: {
                              turbo_confirm:
                                "Czy na pewno chcesz usunąć te zajęcia?"
                            } %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      Brak zajęć.
    </div>
  <% end %>
</div>