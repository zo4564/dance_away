<div class="container py-4">
  <div class="mb-4">
    <h1><%= t("admin.teacher_applications.index.title") %></h1>

    <p class="text-muted">
      <%= t("admin.teacher_applications.index.subtitle") %>
    </p>
  </div>

  <% if @applications.any? %>
    <div class="row g-4">
      <% @applications.each do |application| %>
        <div class="col-12 col-lg-6">
          <div class="card shadow-sm h-100">
            <div class="card-body">
              <h2 class="h5">
                <%= application.lesson.dance_class.name %>
              </h2>

              <p class="text-muted">
                <%= l(application.lesson.starts_at, format: :long) %>
              </p>

              <hr>

              <p>
                <strong><%= t("admin.teacher_applications.index.teacher") %>:</strong><br>
                <%= application.teacher.first_name %>
                <%= application.teacher.last_name %>
              </p>

              <div class="d-flex gap-2">
                <%= button_to t("admin.teacher_applications.index.accept"),
                              accept_admin_teacher_application_path(application),
                              method: :patch,
                              class: "btn btn-success" %>

                <%= button_to t("admin.teacher_applications.index.reject"),
                              reject_admin_teacher_application_path(application),
                              method: :patch,
                              class: "btn btn-outline-danger" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t("admin.teacher_applications.index.empty") %>
    </div>
  <% end %>
</div>