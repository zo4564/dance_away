<%= form_with model: [:admin, lesson] do |form| %>
  <% if lesson.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% lesson.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :dance_class_id,
                   t("admin.lessons.form.dance_class"),
                   class: "form-label" %>

    <%= form.collection_select :dance_class_id,
                               dance_classes,
                               :id,
                               :name,
                               {
                                 prompt: t("admin.lessons.form.select_dance_class")
                               },
                               {
                                 class: "form-select"
                               } %>
  </div>

  <div class="mb-3">
    <%= form.label :teacher_id,
                   t("admin.lessons.form.teacher"),
                   class: "form-label" %>

    <%= form.collection_select :teacher_id,
                               teachers,
                               :id,
                               ->(teacher) {
                                 "#{teacher.first_name} #{teacher.last_name}"
                               },
                               {
                                 include_blank: t("admin.lessons.form.no_teacher")
                               },
                               {
                                 class: "form-select"
                               } %>
  </div>

  <div class="mb-3">
    <%= form.label :starts_at,
                   t("admin.lessons.form.starts_at"),
                   class: "form-label" %>

    <%= form.datetime_local_field :starts_at,
                                  class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :capacity,
                   t("admin.lessons.form.capacity"),
                   class: "form-label" %>

    <%= form.number_field :capacity,
                          min: 1,
                          class: "form-control" %>
  </div>

  <%= form.submit(
        lesson.persisted? ?
          t("admin.lessons.form.update") :
          t("admin.lessons.form.create"),
        class: "btn btn-primary"
      ) %>
<% end %>