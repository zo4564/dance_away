<h1>Panel administracyjny — zajęcia</h1>

<div class="mb-3">
  <%= link_to "Utwórz nowe zajęcia",
              new_admin_lesson_path,
              class: "btn btn-primary" %>

  <%= link_to "Zgłoszenia nauczycieli",
              admin_teacher_applications_path,
              class: "btn btn-outline-secondary ms-2" %>
</div>

<% if @lessons.any? %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
      <tr>
        <th>Data i godzina</th>
        <th>Zajęcia</th>
        <th>Styl</th>
        <th>Prowadzący</th>
        <th>Miejsca</th>
        <th>Akcje</th>
      </tr>
      </thead>

      <tbody>
      <% @lessons.each do |lesson| %>
        <tr>
          <td>
            <%= l(lesson.starts_at, format: :long) %>
          </td>

          <td>
            <%= lesson.dance_class.name %>
          </td>

          <td>
            <%= lesson.dance_class.dance_style.name %>
          </td>

          <td>
            <% applications = lesson.teacher_applications.select do |application|
              application.status.in?(%w[pending accepted])
            end %>

            <% if applications.any? %>
              <%= form_with model: [:admin, lesson],
                            url: change_teacher_admin_lesson_path(lesson),
                            method: :patch,
                            class: "d-flex gap-1" do |form| %>

                <%= form.collection_select :teacher_id,
                                           applications.map(&:teacher),
                                           :id,
                                           ->(teacher) {
                                             "#{teacher.first_name} #{teacher.last_name}"
                                           },
                                           {
                                             prompt: "Wybierz prowadzącego",
                                             selected: lesson.teacher_id
                                           },
                                           {
                                             class: "form-select form-select-sm"
                                           } %>

                <%= form.submit "Zapisz",
                                class: "btn btn-sm btn-outline-success" %>
              <% end %>

            <% elsif lesson.teacher.present? %>
              <span>
                <%= lesson.teacher.first_name %>
                <%= lesson.teacher.last_name %>
              </span>

            <% else %>
              <span class="text-muted">
                Brak prowadzącego
              </span>
            <% end %>

            <% applications_count = lesson.teacher_applications.count %>

            <% if applications_count > 0 %>
              <div class="mt-1">
                <small class="text-muted">
                  Zgłoszenia: <%= applications_count %>
                </small>
              </div>
            <% end %>
          </td>

          <td>
            <%= lesson.booked_places %> / <%= lesson.capacity %>
          </td>

          <td>
            <div class="d-flex flex-wrap gap-2">
              <%= link_to "Uczestnicy",
                          participants_admin_lesson_path(lesson),
                          class: "btn btn-sm btn-outline-primary" %>

              <%= link_to "Edytuj",
                          edit_admin_lesson_path(lesson),
                          class: "btn btn-sm btn-outline-secondary" %>

              <%= button_to "Usuń",
                            admin_lesson_path(lesson),
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger",
                            data: {
                              turbo_confirm: "Czy na pewno chcesz usunąć te zajęcia?"
                            } %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info">
    Brak utworzonych zajęć.
  </div>
<% end %>