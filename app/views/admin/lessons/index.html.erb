<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= t("admin.lessons.index.title") %></h1>
  </div>

  <div class="mb-3">
    <%= link_to t("admin.lessons.index.new_lesson"),
                new_admin_lesson_path,
                class: "btn btn-primary" %>

    <%= link_to t("admin.lessons.index.users"),
                admin_users_path,
                class: "btn btn-outline-secondary ms-2" %>
  </div>

  <% if @lessons.any? %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
        <tr>
          <th><%= t("admin.lessons.index.date") %></th>
          <th><%= t("admin.lessons.index.lesson") %></th>
          <th><%= t("admin.lessons.index.style") %></th>
          <th><%= t("admin.lessons.index.teacher") %></th>
          <th><%= t("admin.lessons.index.places") %></th>
          <th><%= t("admin.lessons.index.actions") %></th>
        </tr>
        </thead>

        <tbody>
        <% @lessons.each do |lesson| %>
          <tr>
            <td>
              <%= l(lesson.starts_at, format: :long) %>
            </td>

            <td>
              <%= lesson.dance_class.name %>
            </td>

            <td>
              <%= lesson.dance_class.dance_style.name %>
            </td>

            <td>
              <% applications = lesson.teacher_applications %>

              <% if lesson.teacher.present? %>
                <div class="d-grid w-100"
                     style="grid-template-columns: minmax(0, 1fr) auto;">
                  <span>
                    <%= lesson.teacher.first_name %>
                    <%= lesson.teacher.last_name %>
                  </span>

                  <%= button_to remove_teacher_admin_lesson_path(lesson),
                                method: :patch,
                                class: "btn btn-sm btn-outline-danger px-2 py-0 ms-2",
                                title: t("admin.lessons.index.remove_teacher"),
                                aria: {
                                  label: t("admin.lessons.index.remove_teacher")
                                },
                                data: {
                                  turbo_confirm: t(
                                    "admin.lessons.index.remove_teacher_confirmation"
                                  )
                                } do %>
                    &times;
                  <% end %>
                </div>

              <% elsif applications.any? %>
                <%= form_with model: [:admin, lesson],
                              url: change_teacher_admin_lesson_path(lesson),
                              method: :patch,
                              class: "d-flex gap-1" do |form| %>

                  <%= form.collection_select :teacher_id,
                                             applications.map(&:teacher),
                                             :id,
                                             ->(teacher) {
                                               "#{teacher.first_name} #{teacher.last_name}"
                                             },
                                             {
                                               prompt: t("admin.lessons.index.select_teacher")
                                             },
                                             {
                                               class: "form-select form-select-sm"
                                             } %>

                  <%= form.submit t("admin.lessons.index.save"),
                                  class: "btn btn-sm btn-outline-success" %>
                <% end %>

              <% else %>
                <span class="text-muted">
                  <%= t("admin.lessons.index.no_teacher") %>
                </span>
              <% end %>

              <% applications_count = lesson.teacher_applications.count %>

              <% if applications_count > 0 %>
                <div class="mt-1">
                  <small class="text-muted">
                    <%= t("admin.lessons.index.applications",
                          count: applications_count) %>
                  </small>
                </div>
              <% end %>
            </td>

            <td>
              <%= lesson.booked_places %> / <%= lesson.capacity %>
            </td>

            <td>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to t("admin.lessons.index.participants"),
                            participants_admin_lesson_path(lesson),
                            class: "btn btn-sm btn-outline-primary" %>

                <%= link_to t("admin.lessons.index.edit"),
                            edit_admin_lesson_path(lesson),
                            class: "btn btn-sm btn-outline-secondary" %>

                <%= button_to t("admin.lessons.index.delete"),
                              admin_lesson_path(lesson),
                              method: :delete,
                              class: "btn btn-sm btn-outline-danger",
                              data: {
                                turbo_confirm: t(
                                  "admin.lessons.index.delete_confirmation"
                                )
                              } %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t("admin.lessons.index.empty") %>
    </div>
  <% end %>
</div>