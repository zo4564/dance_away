<%= form_with model: [:admin, user] do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :first_name,
                   t("admin.users.form.first_name"),
                   class: "form-label" %>

    <%= form.text_field :first_name,
                        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :last_name,
                   t("admin.users.form.last_name"),
                   class: "form-label" %>

    <%= form.text_field :last_name,
                        class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :email,
                   t("admin.users.form.email"),
                   class: "form-label" %>

    <%= form.email_field :email,
                         class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :password,
                   t("admin.users.form.password"),
                   class: "form-label" %>

    <%= form.password_field :password,
                            class: "form-control" %>

    <% if user.persisted? %>
      <div class="form-text">
        <%= t("admin.users.form.password_hint") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :password_confirmation,
                   t("admin.users.form.password_confirmation"),
                   class: "form-label" %>

    <%= form.password_field :password_confirmation,
                            class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :role_ids,
                   t("admin.users.form.roles"),
                   class: "form-label" %>

    <% roles.each do |role| %>
      <div class="form-check">
        <%= form.check_box :role_ids,
                           {
                             multiple: true,
                             class: "form-check-input"
                           },
                           role.id,
                           nil %>

        <%= form.label "role_ids_#{role.id}",
                       t("roles.names.#{role.name}", default: role.name.humanize),
                       class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <%= form.submit(
        user.persisted? ?
          t("admin.users.form.update") :
          t("admin.users.form.create"),
        class: "btn btn-primary"
      ) %>
<% end %>