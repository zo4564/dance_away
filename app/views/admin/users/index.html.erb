<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1><%= t("admin.users.index.title") %></h1>

      <p class="text-muted mb-0">
        <%= t("admin.users.index.subtitle") %>
      </p>
    </div>

    <%= link_to t("admin.users.index.new_user"),
                new_admin_user_path,
                class: "btn btn-primary" %>
  </div>

  <div class="mb-4">
    <div class="btn-group" role="group">
      <%= link_to t("admin.users.index.all"),
                  admin_users_path,
                  class: "btn #{params[:role].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>

      <% @roles.each do |role| %>
        <%= link_to t("roles.names.#{role.name}", default: role.name.humanize),
                    admin_users_path(role: role.name),
                    class: "btn #{params[:role] == role.name ? 'btn-primary' : 'btn-outline-primary'}" %>
      <% end %>
    </div>
  </div>

  <% if @users.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
        <tr>
          <th><%= t("admin.users.index.first_name") %></th>
          <th><%= t("admin.users.index.last_name") %></th>
          <th><%= t("admin.users.index.email") %></th>
          <th><%= t("admin.users.index.roles") %></th>
          <th><%= t("admin.users.index.actions") %></th>
        </tr>
        </thead>

        <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= user.first_name %>
            </td>

            <td>
              <%= user.last_name %>
            </td>

            <td>
              <%= user.email %>
            </td>

            <td>
              <% user.roles.each do |role| %>
                <span class="badge text-bg-secondary me-1">
                  <%= t("roles.names.#{role.name}", default: role.name.humanize) %>
                </span>
              <% end %>
            </td>

            <td>
              <div class="d-flex flex-wrap gap-2">
                <%= link_to t("admin.users.index.edit"),
                            edit_admin_user_path(user),
                            class: "btn btn-sm btn-outline-secondary" %>

                <% unless user == current_user %>
                  <%= button_to t("admin.users.index.delete"),
                                admin_user_path(user),
                                method: :delete,
                                class: "btn btn-sm btn-outline-danger",
                                data: {
                                  turbo_confirm: t(
                                    "admin.users.index.delete_confirmation"
                                  )
                                } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      <%= t("admin.users.index.empty") %>
    </div>
  <% end %>
</div>