<div class="container py-4">
  <div class="mb-4">
    <%= link_to t(".back"),
                dance_styles_path,
                class: "btn btn-outline-secondary mb-3" %>

    <h1><%= @dance_style.name %></h1>
  </div>

  <%= render "shared/view_switcher", view: @view %>

  <% if @view == "calendar" %>
    <%= render "shared/lessons_calendar",
               week_days: @week_days,
               lessons_by_day: @lessons_by_day %>
  <% else %>
    <%= render "shared/lessons_list",
               lessons: @lessons %>
  <% end %>
</div>