<% if lessons.any? %>
  <div class="row g-4">
    <% lessons.each do |lesson| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <div class="mb-2">
              <span
                class="badge"
                style="background-color: <%= lesson.dance_class.dance_style.color %>;"
              >
                <%= lesson.dance_class.dance_style.name %>
              </span>
            </div>

            <h2 class="h5 card-title">
              <%= lesson.dance_class.name %>
            </h2>

            <p class="mb-2">
              <strong><%= t("lessons.shared.date") %>:</strong>
              <%= l(lesson.starts_at, format: :long) %>
            </p>

            <p class="mb-3">
              <strong><%= t("lessons.shared.places") %>:</strong>
              <%= lesson.available_places %> /
              <%= lesson.capacity %>
            </p>

            <%= link_to t("lessons.shared.details"),
                        lesson_path(lesson),
                        class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">
    <%= t("lessons.shared.empty") %>
  </p>
<% end %>