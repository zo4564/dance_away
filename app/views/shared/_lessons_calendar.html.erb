<div class="d-flex justify-content-between align-items-center mb-4">
  <%= link_to t("lessons.shared.previous_week"),
              url_for(week: (@week_start - 7.days).to_date, view: "calendar"),
              class: "btn btn-outline-primary" %>

  <div class="text-center">
    <div class="fw-semibold">
      <%= l(@week_start, format: :short) %>
      –
      <%= l(@week_start + 6.days, format: :short) %>
    </div>

    <% if @week_start != Date.current.beginning_of_week %>
      <%= link_to t("lessons.shared.current_week"),
                  url_for(week: Date.current, view: "calendar"),
                  class: "btn btn-sm btn-outline-secondary mt-1" %>
    <% end %>
  </div>

  <%= link_to t("lessons.shared.next_week"),
              url_for(week: (@week_start + 7.days).to_date, view: "calendar"),
              class: "btn btn-outline-primary" %>
</div>

<div class="row g-3">
  <% week_days.each do |day| %>
    <div class="col-12 col-md">
      <div class="card h-100">
        <div class="card-header">
          <strong>
            <%= l(day, format: :weekday) %>
          </strong>

          <div class="text-muted small">
            <%= l(day, format: :short) %>
          </div>
        </div>

        <div class="card-body">
          <% lessons_by_day.fetch(day, []).each do |lesson| %>
            <%= link_to lesson_path(lesson),
                        class: "text-decoration-none" do %>
              <div class="border rounded p-2 mb-2">
                <div
                  class="small fw-semibold"
                  style="color: <%= lesson.dance_class.dance_style.color %>;"
                >
                  <%= lesson.dance_class.dance_style.name %>
                </div>

                <div class="fw-semibold text-dark">
                  <%= lesson.dance_class.name %>
                </div>

                <div class="small text-muted">
                  <%= l(lesson.starts_at, format: :time) %>
                  –
                  <%= l(lesson.ends_at, format: :time) %>
                </div>

                <% if lesson.teacher.present? %>
                  <div class="small text-muted">
                    <%= lesson.teacher.first_name %>
                    <%= lesson.teacher.last_name %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if lessons_by_day.fetch(day, []).empty? %>
            <span class="text-muted small">
              <%= t("lessons.shared.empty_day") %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>